FROM jupyter/base-notebook:latest
ARG spark_version=4.0.0
ARG hadoop_version=3.3 

USER root 
RUN apt-get update && apt-get install -y curl

RUN apt-get update && \
    apt-get install -y openjdk-17-jdk && \
    apt-get clean

RUN ln -sfn /usr/lib/jvm/java-17-openjdk-$(dpkg --print-architecture) /usr/lib/jvm/default-java
ENV JAVA_HOME=/usr/lib/jvm/default-java
ENV PATH="$JAVA_HOME/bin:$PATH"



# Python-Pakete für Spark 4.0
RUN pip3 install delta-spark==4.0.0
RUN pip3 install pyspark==4.0.0
RUN pip3 install boto3
RUN pip3 install minio
RUN pip3 install sparksql-magic
RUN pip3 install pandas
RUN pip3 install pyarrow
RUN pip3 install fastparquet
RUN pip3 install avro
RUN pip3 install pyorc
RUN pip3 install jsons
RUN pip3 install kaggle
RUN pip3 install deltalake